#!/usr/bin/env python3
"""Lab 3 passes when the service, environment and infrastructure exist, a deploy succeeded,
and the live app answers /health."""
import sys
sys.path.insert(0, "/opt/harness/sda")
import sda_checks as sda

missing = [f"{kind} {ident}" for kind, ident in (("environment", sda.ENV_ID),
                                                  ("infrastructure", sda.INFRA_ID),
                                                  ("service", sda.SERVICE_ID))
           if not sda.entity_exists(kind, ident)]
if missing:
    sda.fail(f"見つかりません: {', '.join(missing)}。これらの識別子をそのまま使って作成するよう、"
             "エージェントに依頼してください（このラボのプロンプトで識別子を指定しています）。")

pid = sda.find_pipeline()
if not pid or not sda.step_types(sda.pipeline_dict(pid), "Deployment"):
    sda.fail("showcase パイプラインには Deploy ステージがまだありません。追加するよう、エージェントに依頼してください。")

runs = sda.executions(pid) or []
deployed = [r for r in runs if r.get("status") in sda.PASSED and
            any(n.get("status") == "Success" for n in sda.stage_nodes(r, "Deployment"))]
if not deployed:
    if runs and runs[0].get("status") in sda.IN_PROGRESS:
        sda.fail("パイプラインはまだ実行中です。完了したら、もう一度 Check をクリックしてください。")
    sda.fail("パイプラインのデプロイがまだ成功していません。パイプラインを実行し、Deploy ステージが失敗した場合は、"
             "失敗したステップをクリックして Analyze Error を使ってください。")

r = sda.app_get("/health")
if r is None:
    sda.fail("デプロイは成功しましたが、アプリがまだ応答していません。30 秒待ってから、もう一度 Check をクリックしてください。")
if r.status_code != 200:
    sda.fail(f"アプリの /health が HTTP {r.status_code} を返しました。showcase.yaml の release.healthy が true になっているか "
             "確認してから、パイプラインをもう一度実行してください。")

print("Lab 3 complete: your app is live in Kubernetes.")
