#!/usr/bin/env python3
"""Lab 3 passes when the service, environment and infrastructure exist, a deploy succeeded,
and the live app answers /health."""
import sys
sys.path.insert(0, "/opt/harness/sda")
import sda_checks as sda

missing = [f"{kind} {ident}" for kind, ident in (("environment", sda.ENV_ID),
                                                  ("infrastructure", sda.INFRA_ID),
                                                  ("service", sda.SERVICE_ID))
           if not sda.entity_exists(kind, ident)]
if missing:
    sda.fail(f"Couldn't find: {', '.join(missing)}. Ask the agent to create them, with exactly those "
             "identifiers (the prompts in this lab pin them).")

pid = sda.find_pipeline()
if not pid or not sda.step_types(sda.pipeline_dict(pid), "Deployment"):
    sda.fail("Your showcase pipeline has no Deploy stage yet. Ask the agent to add one.")

runs = sda.executions(pid) or []
deployed = [r for r in runs if r.get("status") in sda.PASSED and
            any(n.get("status") == "Success" for n in sda.stage_nodes(r, "Deployment"))]
if not deployed:
    if runs and runs[0].get("status") in sda.IN_PROGRESS:
        sda.fail("Your pipeline is still running. Click Check again when it finishes.")
    sda.fail("Your pipeline hasn't deployed successfully yet. Run it, and if the Deploy stage fails, "
             "click the failed step and use Analyze Error.")

r = sda.app_get("/health")
if r is None:
    sda.fail("Your deploy succeeded, but the app isn't answering yet. Wait 30 seconds and click Check again.")
if r.status_code != 200:
    sda.fail(f"Your app answered /health with HTTP {r.status_code}. Check that release.healthy is true "
             "in showcase.yaml, then run the pipeline again.")

print("Lab 3 complete: your app is live in Kubernetes.")
