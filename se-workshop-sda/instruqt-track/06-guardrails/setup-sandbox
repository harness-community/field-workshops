#!/usr/bin/env python3
"""Switch on the deploy_needs_approval policy, and make sure main holds a healthy release."""
import sys
import time
sys.path.insert(0, "/opt/harness/sda")
import sda_checks as sda

sda.set_policy_set_enabled(True)

# Keep health checks on this sandbox's delegate (see Lab 4's setup)
try:
    sda.pin_delegate()
except (SystemExit, Exception):
    print("Couldn't pin the pipeline's delegate.")

# Lab 4 ends with a bad release on main unless the student fixed it forward
config = sda.showcase()
if (config.get("release") or {}).get("healthy") is False:
    version = sda.bump_patch(config.get("version"))
    try:
        sda.edit_showcase(f"Fix forward to a healthy {version}", version=version, healthy=True)
        print(f"Fixed forward to healthy release {version}.")
    except SystemExit:
        print("Couldn't fix forward; the student can set release.healthy back to true.")

with open(f"{sda.SDA_DIR}/guardrails_started_ms", "w") as f:
    f.write(str(int(time.time() * 1000)))
