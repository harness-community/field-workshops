#!/usr/bin/env python3

import time
import requests
from pyharnessworkshop import utils

APP_URL = utils.instruqt.get_agent_variable("APP_URL")

for attempt in range(3):
    try:
        if requests.get(f"{APP_URL}/health", timeout=10).status_code == 200:
            print(f"App is healthy at {APP_URL}")
            break
    except requests.RequestException as e:
        print(f"Attempt {attempt + 1}: {e}")
    time.sleep(5)
else:
    utils.instruqt.raise_lab_failure_message(
        "Your app isn't responding yet. Give it a few seconds and click Check again."
    )
